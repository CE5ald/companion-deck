<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 10.0.19041 gives us the WinRT projections we need for GSMTC (media sessions). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>CompanionDeck.Host</RootNamespace>
    <AssemblyName>CompanionDeck.Host</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Tray-only agent: no console window in Release. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Only used to turn shell HICONs into PNGs for the launcher tiles. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <!-- WMI: display brightness, GPU adapter details and thermal zones. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
